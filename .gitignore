# Home Assistant runtime data (contains real API keys at runtime)
data/
/data/options.json

# Google OAuth tokens generated at runtime
*.json
!repository.yaml
# Captured reader responses the tests read back — data, not a runtime secret.
!jarvis/tests/fixtures/*.json
# The Home Assistant integration cannot load without these.
!jarvis/ha_integration/**/*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Environment / secrets
.env
.env.*
*.key
*.pem
secrets.yaml

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# macOS SMB deletion placeholders on the network share
.smbdelete*
